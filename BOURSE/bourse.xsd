<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:element name="bourse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="societe" maxOccurs="unbounded" type="T_SOCIETE"></xsd:element>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:complexType name="T_SOCIETE">
        <xsd:sequence>
            <xsd:element name="codeSociete" type="xsd:string"></xsd:element>
            <xsd:element name="nomSociete" type="xsd:string"></xsd:element>
            <xsd:element name="dateIntroduction" type="xsd:date"></xsd:element>
            <xsd:element name="cotations" type="T_COTATIONS"></xsd:element>
        </xsd:sequence>
        <xsd:attribute name="type">
            <xsd:simpleType>
                <xsd:restriction  base="xsd:string">
                    <xsd:enumeration value="banque"></xsd:enumeration>
                    <xsd:enumeration value="assurance"></xsd:enumeration>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:attribute>
    </xsd:complexType>
    <xsd:complexType name="T_COTATIONS">
        <xsd:sequence>
            <xsd:element name="cotation" maxOccurs="unbounded" type="T_COTATION"></xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="T_COTATION">
        <xsd:attribute name="num" type="xsd:int"></xsd:attribute>
        <xsd:attribute name="dateCotation" type="xsd:date"></xsd:attribute>
        <xsd:attribute name="valeurAction">
            <xsd:simpleType>
                <xsd:restriction base="xsd:double">
                    <xsd:minExclusive value="0"></xsd:minExclusive>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:attribute>
    </xsd:complexType>
</xsd:schema>
